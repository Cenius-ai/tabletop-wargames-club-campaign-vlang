# Every value below has a working in-code default, so the app boots with no .env at all.
# This file only documents the knobs; `cp .env.example .env` is optional.

# Port the uvicorn server binds on (0.0.0.0). Default: 8000
PORT=8000

# SQLite file, relative to the project root. Default: campaign.db
CAMPAIGN_DB=campaign.db

# Set to 1 when serving over HTTPS so the session cookie gets the Secure flag.
# Leave 0 for plain-http local/preview runs, otherwise the cookie is dropped.
COOKIE_SECURE=0
